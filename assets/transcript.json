 "gaps": [],
 "segments": [
  {
   "id": 0,
   "start": 0.0,
   "end": 8.24,
   "text": "في رحلة جوية كان من المفترض أن تنتهي بهبوط آمن في جزر البهامة"
  },
  {
   "id": 1,
   "start": 8.4,
   "end": 13.42,
   "text": "تحولت السماء فجأة إلى مسرح لكارثة مروعة"
  },
  {
   "id": 2,
   "start": 13.55,
   "end": 18.27,
   "text": "تسعة أشخاص كانوا علامت نطائرة خاصة"
  },
  {
   "id": 3,
   "start": 18.3,
   "end": 28.3,
   "text": "لم يعلموا أن رحلتهم الأخيرة ستتحول إلى واحدة من أكثر اللحظات رعبا في تاريخ الطيران الحديث"
  },
  {
   "id": 4,
   "start": 28.62,
   "end": 35.1,
   "text": "لكن الأكثر إثارة للرعب لم يكن سقوط الطائرة وحدة"
  },
  {
   "id": 5,
   "start": 35.1,
   "end": 40.02,
   "text": "بل التسجيل الصوتي الذي كشفت دقائق والثوانية الأخيرة"
  },
  {
   "id": 6,
   "start": 40.02,
   "end": 43.64,
   "text": "بين قائد الطائرة وبرج المراقبة"
  },
  {
   "id": 7,
   "start": 43.7,
   "end": 46.48,
   "text": "فما ذا حدث في تلك الرحلة"
  },
  {
   "id": 8,
   "start": 46.48,
   "end": 51.24,
   "text": "ولماذا فقد الطيار السيطرة على الطائرة"
  },
  {
   "id": 9,
   "start": 51.24,
   "end": 55.14,
   "text": "في الأولي من نوفمبر عام الفين وستة وعشرين"
  },
  {
   "id": 10,
   "start": 55.14,
   "end": 61.08,
   "text": "أقلع الطائرة خاصة من طراز Layer Jet 60 من مطار Austin Bergstrom"
  },
  {
   "id": 11,
   "start": 61.08,
   "end": 66.57,
   "text": "الدولي في ولاية دكسس الأمريكية. كانت وجهتها مطارا نورث"
  },
  {
   "id": 12,
   "start": 66.57,
   "end": 72.31,
   "text": "اليثيورا في جزر البهامة. على متنها تسعة أشخاص. وكانت الطائرة"
  },
  {
   "id": 13,
   "start": 72.31,
   "end": 77.05,
   "text": "تحلق على ارتفاع يقارب خمسة وثلاثين الفقدم. واستظهوف"
  },
  {
   "id": 14,
   "start": 77.05,
   "end": 83.2,
   "text": "جوية بدأت تدهور تدريجيا. وبحسب التزجيلات أبلغ الطيار"
  },
  {
   "id": 15,
   "start": 83.2,
   "end": 88.68,
   "text": "برج المراقبة بوجود اترابات جوية متوسطة وتراكم للجليد على"
  },
  {
   "id": 16,
   "start": 88.68,
   "end": 93.82,
   "text": "اجزاء من الطائرة كان الوضع يبدو تحت السيطرة في البداية لكن"
  },
  {
   "id": 17,
   "start": 93.82,
   "end": 99.82,
   "text": "الامور لم تستمر طويلا مع دخول الطائرة منطقته طول الامطار"
  },
  {
   "id": 18,
   "start": 99.82,
   "end": 103.82,
   "text": "طلب الطيار تغيرا الارتفاع والسعودة الى مستوى اعلى"
  },
  {
   "id": 19,
   "start": 103.82,
   "end": 109.74,
   "text": "بحثا عن ضروف جوية اكثر استقرارا وبعد وقت قصير بدأت"
  },
  {
   "id": 20,
   "start": 109.74,
   "end": 116.03,
   "text": "طائرة تفقد ارتفاعها بصورة مفاجئة وخطيرة. هنا تحولت الرحلة"
  },
  {
   "id": 21,
   "start": 116.03,
   "end": 121.87,
   "text": "الى حالة طوارئا حقيقية. لدينا تراكم لجليد والترابات جوية"
  },
  {
   "id": 22,
   "start": 121.87,
   "end": 128.01,
   "text": "وتوسطة. ما درجة الحرارة الخارجية لديكم? ناق السبع واربعون درجة"
  },
  {
   "id": 23,
   "start": 128.01,
   "end": 133.09,
   "text": "ميقوية. نحن نتعامل مع جليد لكن الاترابات متوسطة. نحن نفقد"
  },
  {
   "id": 24,
   "start": 133.09,
   "end": 138.25,
   "text": "الاتفاع نعلن حالة التوارئ. نداء استغاثة. نداء استغاثة. نهب"
  },
  {
   "id": 25,
   "start": 138.25,
   "end": 140.37,
   "text": "بمعدل عشرة ألف قدم في الدقيقة"
  },
  {
   "id": 26,
   "start": 140.37,
   "end": 142.95,
   "text": "أخبريني بما تحتاجين إليه"
  },
  {
   "id": 27,
   "start": 142.95,
   "end": 143.91,
   "text": "نحن معك"
  },
  {
   "id": 28,
   "start": 143.91,
   "end": 146.07,
   "text": "نحن في حالة هبوط متسارح"
  },
  {
   "id": 29,
   "start": 146.07,
   "end": 148.37,
   "text": "عشرون ألف قدم في الدقيقة"
  },
  {
   "id": 30,
   "start": 148.44,
   "end": 149.58,
   "text": "سوف نصدم بالأرض"
  },
  {
   "id": 31,
   "start": 150.26,
   "end": 151.18,
   "text": "أنا معك"
  },
  {
   "id": 32,
   "start": 151.18,
   "end": 152.66,
   "text": "تحدث إليه"
  },
  {
   "id": 33,
   "start": 152.76,
   "end": 155.36,
   "text": "نحن نهبط بمعدل إثنين"
  },
  {
   "id": 34,
   "start": 155.36,
   "end": 157.94,
   "text": "وعشرين ألف قدم في الدقيقة"
  },
  {
   "id": 35,
   "start": 157.94,
   "end": 158.84,
   "text": "والطائرة"
  },
  {
   "id": 36,
   "start": 158.84,
   "end": 161.44,
   "text": "تميل بزاوية ستين درجة"
  },
  {
   "id": 37,
   "start": 162.75,
   "end": 164.75,
   "text": "لم يعد لدينا وقت"
  },
  {
   "id": 38,
   "start": 164.75,
   "end": 167.29,
   "text": "في حوال الساعة الثانية"
  },
  {
   "id": 39,
   "start": 167.29,
   "end": 168.97,
   "text": "10 و 50 دقيقة"
  },
  {
   "id": 40,
   "start": 168.97,
   "end": 174.03,
   "text": "ظهرا بالتوقيت المحلي سقطت الطائرة في منطقة سكنية"
  },
  {
   "id": 41,
   "start": 174.03,
   "end": 180.35,
   "text": "بمقاطعة في فلوريدا. ارتطمت بالارض بقوة هائلة. اعقبها"
  },
  {
   "id": 42,
   "start": 180.35,
   "end": 185.77,
   "text": "فيجار واشتعال النيران. وتحول موقع الحادف الى مشهد من"
  },
  {
   "id": 43,
   "start": 185.77,
   "end": 191.6,
   "text": "الدمعر. بينما تصاعدت اعمدة الدخان الاسود في السماء. واكدت"
  },
  {
   "id": 44,
   "start": 191.6,
   "end": 195.62,
   "text": "الصلطات وفات الاشخاص التسعة الذين كانوا علمتنا الطائرة."
  },
  {
   "id": 45,
   "start": 195.62,
   "end": 200.66,
   "text": "كما اخليا نحو ستمائة شخص من منطقة سكنية قريبة كاجراء"
  },
  {
   "id": 46,
   "start": 200.66,
   "end": 206.46,
   "text": "احترازي. ووصف حاكم فلوريدا رون دي سانتس الحادث بانه كارثة"
  },
  {
   "id": 47,
   "start": 206.46,
   "end": 212.28,
   "text": "مروعة. ما السبب الحقيقي وراء سقوط الطائرة. هنا يبرز السؤال"
  },
  {
   "id": 48,
   "start": 212.28,
   "end": 217.42,
   "text": "الاهم. تشير المعلومات الاولية الى ان الطاقة ما واجهت راقم"
  },
  {
   "id": 49,
   "start": 217.42,
   "end": 221.94,
   "text": "الجليد والاترابات الجوية والامطار قبل ان تدخل الطائرة في"
  },
  {
   "id": 50,
   "start": 221.94,
   "end": 227.86,
   "text": "هبوط حاد وغير طبيعي. وقد تكون هذه الظروف مرتبطة بفقدان"
  },
  {
   "id": 51,
   "start": 227.86,
   "end": 232.64,
   "text": "السيطرة على الطائرة. لكن لا يمكن الجزم بان الجليد او التقس"
  },
  {
   "id": 52,
   "start": 232.64,
   "end": 237.58,
   "text": "واحدهما تسبب في الحادث. فحتى الان لم يصدر المحقيقون"
  },
  {
   "id": 53,
   "start": 237.58,
   "end": 242.72,
   "text": "نتيجة نهاية تحدد السبب المباشر. وقد بدأ المجلس الوطني"
  },
  {
   "id": 54,
   "start": 242.72,
   "end": 246.18,
   "text": "لسلامة النقل الامريكي بالتعاون مع ادارة الطيران"
  },
  {
   "id": 55,
   "start": 246.18,
   "end": 250.44,
   "text": "الفدرالية التحقيق في الحادث. لمعرفة ما حدث داخل"
  },
  {
   "id": 56,
   "start": 250.44,
   "end": 252.8,
   "text": "خلال اللحظاتها الأخيرة"
  },
  {
   "id": 57,
   "start": 252.8,
   "end": 256.32,
   "text": "تسعة أشخاص ساعدوا إلى الطائرة"
  },
  {
   "id": 58,
   "start": 256.32,
   "end": 261.04,
   "text": "وهم يعتقدون أنهم في رحلة عادية نحو وجهتهم"
  },
  {
   "id": 59,
   "start": 261.46,
   "end": 264.22,
   "text": "لكن خلال ثوان معدودة"
  },
  {
   "id": 60,
   "start": 264.9,
   "end": 268.64,
   "text": "تحولت الرحلة إلى مقسات تهد قبل القصر"
  },
  {
   "id": 61,
   "start": 268.92,
   "end": 273.1,
   "text": "ويبقى التسجيل الصوطي شاهدا على اللحظات الأخيرة"
  },
  {
   "id": 62,
   "start": 273.1,
   "end": 277.36,
   "text": "وعلى المحاولات اليائسة لإنقاذ الطارف"
  },
  {
   "id": 63,
   "start": 277.56,
   "end": 279.2,
   "text": "ففي عالم الطيران"
  },
  {
   "id": 64,
   "start": 279.2,
   "end": 286.6,
   "text": "قد تفصل دقائق قليلة بين رحلة طبيعية وكارثة لا يمكن التراجع"
  },
  {
   "id": 65,
   "start": 286.6,
   "end": 287.1,
   "text": "عليها."
  }
 ],
